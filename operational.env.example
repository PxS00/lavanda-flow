# Copy to .env.operational and replace the required placeholders.
# Use either the Supabase direct endpoint (IPv6) or the Supavisor session
# endpoint (IPv4), always on port 5432. Keep sslmode=verify-full and use the
# provider CA trust configuration required by the selected runtime.
# On Windows, use an absolute Windows host path (for example C:/certs/ca.crt)
# for the CA file; Compose resolves it for both application and backup tooling.
# Single-quote any value containing $ or # so Compose keeps it literal.
# Do not use double quotes or $$ escaping for those values.
SPRING_DATASOURCE_URL=jdbc:postgresql://<supabase-host>:5432/<database>?sslmode=verify-full&sslrootcert=/run/secrets/lavanda-postgres-ca.crt
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
LAVANDA_DB_CA_CERTIFICATE_PATH=

# Choose this after inspecting the current Supabase project limits and leave
# headroom for provider-managed connections. Do not use transaction pooling.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0

# Safe runtime defaults.
LAVANDA_HTTP_PORT=8080
LAVANDA_SESSION_COOKIE_SECURE=false
EXPIRATION_ALERT_WINDOW_DAYS=30

# Initial operator bootstrap is opt-in. Remove the plaintext password from the
# workstation configuration after successful provisioning where practical.
LAVANDA_SECURITY_BOOTSTRAP_ENABLED=false
LAVANDA_SECURITY_BOOTSTRAP_USERNAME=
LAVANDA_SECURITY_BOOTSTRAP_PASSWORD=
