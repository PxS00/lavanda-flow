# Copy to .env.operational and replace the required blank values.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Safe runtime defaults.
LAVANDA_HTTP_PORT=8080
LAVANDA_SESSION_COOKIE_SECURE=false
EXPIRATION_ALERT_WINDOW_DAYS=30

# Initial operator bootstrap is opt-in. Remove the plaintext password from the
# workstation configuration after successful provisioning where practical.
LAVANDA_SECURITY_BOOTSTRAP_ENABLED=false
LAVANDA_SECURITY_BOOTSTRAP_USERNAME=
LAVANDA_SECURITY_BOOTSTRAP_PASSWORD=
